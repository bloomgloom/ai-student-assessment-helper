{
  "name": "ai-student-assessment-helper-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "description": "Teacher desktop shell for assessment and assignment workflows.",
  "scripts": {
    "assessment:dev": "npm run dev --prefix assessment",
    "assessment:build": "npm run build --prefix assessment",
    "electron:dev": "npm run assessment:build && electron .",
    "electron:pack": "npm run assessment:build && electron-builder --dir",
    "electron:dist": "npm run assessment:build && electron-builder",
    "build:mac": "npm run assessment:build && electron-builder --mac",
    "build:mac:app": "npm run assessment:build && electron-builder --mac --dir",
    "build:windows": "npm run assessment:build && electron-builder --win --x64"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "adm-zip": "^0.5.17",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "kr.co.teacher.assessment-helper",
    "productName": "AI Student Assessment Helper",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "files": [
      "electron/**/*",
      "assessment/server/dist/**/*",
      "assessment/client/dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
